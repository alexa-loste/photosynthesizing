# Copy to toreply.env and edit. Everything here has a working default, so in most
# cases you only need TOREPLY_REMOTE.

# SSH host for the always-on Mac. Must be reachable as `ssh <this>` — set it up in
# ~/.ssh/config, ideally pointing at the machine's Tailscale name.
TOREPLY_REMOTE=mini

# Where the daemon listens. "auto" resolves to the Mac's own Tailscale address, so it's
# reachable from your other devices but never from the local network. Use 127.0.0.1 if
# you're fronting it with `tailscale serve` for HTTPS.
TOREPLY_BIND=auto

# Change this if you're running a second instance for another person on the same Mac
# (each macOS user account has its own chat.db and needs its own port).
TOREPLY_PORT=8787
